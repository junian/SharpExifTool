<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaDemo.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="SharpExifTool Avalonia Demo"
        Width="900"
        Height="650"
        MinWidth="560"
        MinHeight="400">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">

        <Button x:Name="SelectImageButton"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Padding="16,6"
                Content="Select Image..."
                Click="OnSelectImageClicked" />

        <TextBlock x:Name="SelectedFileText"
                   Grid.Row="1"
                   Text="No image selected."
                   TextTrimming="CharacterEllipsis" />

        <TextBox x:Name="ResultTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,monospace"
                 PlaceholderText="ExifTool results will appear here." />

        <ProgressBar x:Name="BusyIndicator"
                     Grid.Row="3"
                     Height="4"
                     IsIndeterminate="True"
                     IsVisible="False" />
    </Grid>

</Window>
